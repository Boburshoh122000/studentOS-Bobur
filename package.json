    "@tsparticles/slim": "^3.9.1",
    "dompurify": "^3.4.8",
    "framer-motion": "^12.34.3",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
