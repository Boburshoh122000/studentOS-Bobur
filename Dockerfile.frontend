# Frontend Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (using npm install for flexibility with lock file)
RUN npm install --legacy-peer-deps

# Copy source code
COPY . .

# Set API URL -> allows passing at build time
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Set Supabase variables -> allows passing at build time
ARG VITE_SUPABASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Google OAuth client ID (public — safe to bake into frontend bundle)
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

# Build the app
RUN npm run build

# Production image: static file server only — no app node_modules
FROM node:20-alpine AS runtime

WORKDIR /app

RUN npm install -g serve@14

# Copy built app from builder stage (includes dist/serve.json with
# security headers and caching rules, copied from public/)
COPY --from=builder /app/dist ./dist

EXPOSE 4173

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-4173}/ || exit 1

CMD ["sh", "-c", "serve -s dist -l ${PORT:-4173}"]
